{
  "pipeline": [
    { "type": "readers.las", "filename": "INPUT.las" },
    {
      "type": "filters.pmf",
      "max_window_size": 33,
      "slope": 1.0,
      "initial_distance": 0.15,
      "max_distance": 2.5
    },
    { "type": "writers.las", "filename": "OUTPUT_ground.las", "where": "Classification == 2" }
  ]
}
