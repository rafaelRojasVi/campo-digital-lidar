# Campo Digital local PostgreSQL/PostGIS
APP_ENV=development
# Copy to .env for local development. Never commit .env.

POSTGRES_DB=campo_digital
POSTGRES_USER=campo_digital
POSTGRES_PASSWORD=replace-with-local-random-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Google Workspace sign-in (Transelec) -------------------------------
# Optional locally: development also offers the seeded dev-login identities.
# Required in any hosted environment that must offer "Continuar con Google".
# See docs/platform/google-workspace-oauth-handoff.md for what to create in
# Google Cloud, and ADR-010 for why Transelec signs in this way.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must match the origin the browser actually reaches this API on; the
# redirect URI registered in Google Cloud is this value + /auth/google/callback
# GOOGLE_REDIRECT_BASE_URL=http://localhost:8000
# The `hd` claim an id_token must carry, exactly, to be accepted.
# GOOGLE_WORKSPACE_DOMAIN=campodigital.cl
# Encrypts the short-lived sign-in flow cookie (a Fernet key):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PLATFORM_TOKEN_ENCRYPTION_KEY=
# The one address that receives ADMIN on `transelect` — and on no other
# product — at its first sign-in. Leave unset to grant nothing automatically.
# TRANSELEC_BOOTSTRAP_ADMIN_EMAIL=
