# Point cloud / geospatial data - NEVER commit client data
*.las
*.laz
*.copc.laz
*.e57
*.ply
*.pcd
*.bin
*.tif
*.tiff
*.zip
data/raw/**
data/interim/**
data/reference/private/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/reference/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# uv
.uv-cache/

# Jupyter
.ipynb_checkpoints/

# mypy/ruff/pytest caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

